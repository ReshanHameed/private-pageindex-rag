# Local Ollama server. This project must only call a local Ollama endpoint.
OLLAMA_BASE_URL=http://localhost:11434

# Default local model requested for this project.
OLLAMA_MODEL=gemma4:e4b

# Local storage directory for SQLite, uploaded PDFs, extracted pages, and trees.
DATA_DIR=data

# Inbox folder for filename-based MCP ingestion (list_inbox / ingest_pdf).
INBOX_DIR=data/inbox

# MCP server: streamable-HTTP bind address (used by `serve-mcp --http`).
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765

# MCP server: optional bearer token for the HTTP transport.
# Leave empty to run unauthenticated on localhost. When set, HTTP clients must
# send `Authorization: Bearer <token>`.
MCP_AUTH_TOKEN=

# Prompt budget controls for local tree search and answer generation.
MAX_TREE_PROMPT_CHARS=45000
MAX_PAGE_CHARS=12000
TREE_MAX_PAGES_PER_NODE=10
TREE_PROMPT_COMPACT_THRESHOLD=4000
